<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Must match App/App.entitlements exactly; the App Group is the only way
	     the share extension can hand the shared text to the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lastglance</string>
	</array>
</dict>
</plist>
